#Exercício 8: Classe "Elevador"(Precisa Corrigir)
#Objetivo: Validar limites antes de alterar o estado.
#Requisito: Armazene andar_atual e total_andares. Crie métodos subir() e descer(). O elevador não pode descer abaixo do térreo (0) nem subir acima do total de andares.
#Estrutura Sugerida:
#Atributos: andar_atual (0), total_andares.
#Métodos: subir(), descer() com if para garantir limites físicos.
class Elevador:
    def __init__(self, andar_atual: int, total_andares: int):
        self.andar_atual = andar_atual
        self.total_andares = total_andares
    
    def subir(self):
        if self.andar_atual < self.total_andares:
            self.andar_atual += 1
            print(f"Subiu para o andar: {self.andar_atual}")
        else:
            print("Andar não Encontrado")
            
    def descer(self):
        if self.andar_atual > 0:
            self.andar_atual -= 1
            print(f"Desceu para o andar: {self.andar_atual}")
        else:
            print("Andar não Encontrado")

elevador = Elevador(0, 10)
elevador.subir()  
elevador.descer() 
elevador.descer() 